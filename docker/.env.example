# Server-Konfiguration für docker compose. Kopiere nach docker/.env und fülle die
# beiden leeren Werte. WIRD NICHT EINGECHECKT.
#
# IMAP_HOST/IMAP_PORT/TLS/MCP_* werden in compose.mcp.yaml gesetzt — hier nur Geheimnisse
# und Persönliches (beides gehört nicht ins Repo).

# Bridge-Login. ACHTUNG: Das ist NICHT das Proton-Passwort, sondern das
# Bridge-Passwort, das die Bridge im Container nach dem `info`-Befehl anzeigt (siehe
# DEPLOY.md). Jede Bridge-Installation erzeugt ihr eigenes Passwort.
BRIDGE_USER=du@example.org
BRIDGE_PASSWORD=

# Benannte Tokens mit Scopes: name=token:scope[,scope] ; mehrere mit Leerzeichen.
MCP_STATIC_TOKENS=agent=<48 Hex-Zeichen>:proton.read,proton.ablage

# Optional: Datenverzeichnis auf dem Host (Bridge-Keyring, OAuth-State, Abruf-Protokoll)
# und der Ordner, in den anhang_ablegen schreibt. Pfade relativ zu docker/.
# PROTON_DATA_DIR=../data
# ATTACHMENT_HOST_DIR=../data/austausch
# Externes Docker-Netz, in dem der Agent läuft, der den MCP nutzt.
# AGENT_NETWORK=agent_net

# Bulk-Läufe (tax_export, scanner_pdfs): Scanner-Adresse und Steuer-Quellordner.
SCANNER_ADDR=scanner@example.org
TAX_FOLDERS=Folders/RECHNUNGEN,Folders/STEUER,Folders/FINANZEN,INBOX
