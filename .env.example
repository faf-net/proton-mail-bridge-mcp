# Proton Mail Connector — Konfiguration (Beispiel)
# Kopiere diese Datei nach .env und trage die echten Werte ein.
# .env wird NICHT eingecheckt (siehe .gitignore). Keine Secrets ins Repo!

# --- Proton Bridge IMAP ---
# Lokal (Bridge auf demselben Rechner): 127.0.0.1
# Im Docker-Netz:                       Containername der Bridge (z. B. bridge)
IMAP_HOST=127.0.0.1
IMAP_PORT=1143

# Bridge-Login. ACHTUNG: NICHT das Proton-Passwort, sondern die von
# Proton Bridge generierten Zugangsdaten (Bridge zeigt sie nach dem Login an).
BRIDGE_USER=du@example.org
BRIDGE_PASSWORD=

# Proton Bridge nutzt ein selbstsigniertes Zertifikat auf 1143 (STARTTLS).
# true = Zertifikat NICHT prüfen. Nur fürs lokale Bridge-IMAP akzeptabel.
IMAP_TLS_VERIFY=false

# --- MCP-Server (Phase: Connector) ---
# Bearer-Token, das Clients gegen den MCP-Server vorweisen müssen.
MCP_AUTH_TOKEN=
MCP_HOST=0.0.0.0
MCP_PORT=8080

# --- Export-Lauf (Phase: Archiv) ---
# Zielverzeichnis für exportierte Mails + Anhänge.
# Lokal z.B. ./export ; auf einem Server ein gemounteter Pfad.
EXPORT_DIR=./export

